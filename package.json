{
  "name": "community-tickets",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "npm run build && npm run deploy:prebuilt",
    "deploy:prebuilt": "npm run db:migrate && cf deploy --prebuilt --mode production",
    "test": "vp test run",
    "typecheck": "cf workers types && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cf d1 migrations apply 12c0001b-54c0-443e-b8ed-b2dcec8a0dcc --dir migrations --pattern 'migrations/*/migration.sql'",
    "db:migrate:local": "cf d1 migrations apply 12c0001b-54c0-443e-b8ed-b2dcec8a0dcc --dir migrations --pattern 'migrations/*/migration.sql' --local --persist-to .cloudflare/state",
    "auth:generate": "auth generate --config auth.cli.ts --adapter drizzle --dialect sqlite --output src/server/db/auth-schema.ts",
    "generate-routes": "tsr generate",
    "prepare": "vp config",
    "e2e": "playwright test",
    "e2e:server": "rm -rf .cloudflare/e2e && cf d1 migrations apply 12c0001b-54c0-443e-b8ed-b2dcec8a0dcc --dir migrations --pattern 'migrations/*/migration.sql' --local --persist-to .cloudflare/e2e && vp build --mode e2e && vp preview --mode e2e --port 3100 --strictPort"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.5",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "qr-scanner": "^1.4.2",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.4",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@playwright/test": "^1.64.1",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "auth": "1.7.12",
    "cf": "^1.0.0-beta.21",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
}
